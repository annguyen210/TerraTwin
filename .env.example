# ---- TerraTwin — cấu hình mẫu. Copy thành .env và điền giá trị thật. ----

# Backend (đặt trước khi chạy uvicorn)
# CORS: danh sách origin cho phép, phân tách bằng dấu phẩy. Production nên đặt cụ thể.
TERRATWIN_CORS=http://localhost:1825

# Giới hạn request/phút cho mỗi IP (0 = tắt). Bảo vệ nguồn Open-Meteo/NASA free.
TERRATWIN_RATE_LIMIT=120

# BẮT BUỘC khi triển khai thật: khóa ký JWT. Không đặt = sinh ngẫu nhiên mỗi lần
# chạy, nghĩa là mọi người dùng bị đăng xuất khi restart.
# Sinh khóa: python -c "import secrets; print(secrets.token_urlsafe(48))"
# TERRATWIN_SECRET=doi-thanh-chuoi-ngau-nhien-cua-ban

# Hạn token đăng nhập (giờ).
TERRATWIN_TOKEN_HOURS=72

# Database. Mặc định SQLite chạy ngay, không cần cài gì.
# Production nên dùng PostgreSQL (cài thêm psycopg trong requirements.txt):
# TERRATWIN_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/terratwin
TERRATWIN_DATABASE_URL=sqlite:///./terratwin.db

# ---- LLM (tùy chọn) — bật Copilot & hỏi What-If bằng lời ----
# KHÔNG phụ thuộc nhà cung cấp: cắm key nào cũng chạy. Không có key thì phần mềm
# vẫn chạy đủ, chỉ dùng trợ lý rule-based.
#
# auto | openai | gemini | anthropic | off   (auto = tự dò theo key đang có)
# TERRATWIN_LLM_PROVIDER=auto
# TERRATWIN_LLM_API_KEY=
# TERRATWIN_LLM_MODEL=
#
# TERRATWIN_LLM_BASE_URL chỉ cần khi dùng nhà cung cấp openai-compatible khác:
#   OpenAI      https://api.openai.com/v1            (mặc định, không cần đặt)
#   DeepSeek    https://api.deepseek.com/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Together    https://api.together.xyz/v1
#   xAI         https://api.x.ai/v1
#   Qwen        https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama      http://localhost:11434/v1            (chạy máy, không cần key)
# TERRATWIN_LLM_BASE_URL=
#
# Ví dụ 1 — Gemini (Google, có bậc miễn phí):
#   TERRATWIN_LLM_PROVIDER=gemini
#   TERRATWIN_LLM_API_KEY=AIza...
#   TERRATWIN_LLM_MODEL=gemini-2.0-flash
#
# Ví dụ 2 — DeepSeek (rẻ, hỗ trợ tiếng Việt tốt):
#   TERRATWIN_LLM_API_KEY=sk-...
#   TERRATWIN_LLM_BASE_URL=https://api.deepseek.com/v1
#   TERRATWIN_LLM_MODEL=deepseek-chat
#
# Ví dụ 3 — Ollama chạy trên máy, hoàn toàn miễn phí, không cần key:
#   TERRATWIN_LLM_PROVIDER=openai
#   TERRATWIN_LLM_BASE_URL=http://localhost:11434/v1
#   TERRATWIN_LLM_MODEL=qwen2.5:7b
#
# Các biến cũ vẫn dùng được: ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY

# Frontend (frontend/.env.local) — URL backend cho trình duyệt gọi tới.
# NEXT_PUBLIC_API=http://localhost:8000
