# ============================================================================
# TerraTwin — mẫu cấu hình. Chép thành `.env` rồi sửa:  cp .env.example .env
# ============================================================================
#
# NGUYÊN TẮC: TerraTwin CHẠY ĐƯỢC MÀ KHÔNG CẦN MỘT KHOÁ NÀO. Không đặt gì cả
# thì 18/18 mũi nhọn vẫn chạy trên dữ liệu thật (Open-Meteo, ERA5, GloFAS, NASA
# POWER, OpenStreetMap, Sentinel-2 qua Microsoft Planetary Computer). Mọi biến
# dưới đây đều là để BẬT THÊM hoặc để chỉnh vận hành, không phải điều kiện chạy.
#
# Biến nào bỏ trống thì tính năng tương ứng tự tắt và NÓI RÕ là đang tắt —
# không có tính năng nào im lặng giả vờ hoạt động.


# ---------------------------------------------------------------------------
# 1. BẮT BUỘC KHI DEPLOY THẬT
# ---------------------------------------------------------------------------

# Khoá ký token đăng nhập VÀ ký liên kết một chạm. Không đặt thì mỗi lần khởi
# động lại sinh ngẫu nhiên một khoá mới → mọi người bị đăng xuất, mọi liên kết
# một chạm đã gửi đi thành vô hiệu.
#   Sinh khoá:  python -c "import secrets; print(secrets.token_urlsafe(48))"
TERRATWIN_SECRET=

# Địa chỉ CÔNG KHAI của giao diện web. Dùng để dựng liên kết một chạm gửi kèm
# tin cảnh báo (Zalo/Telegram/email).
#
# ĐỪNG QUÊN BIẾN NÀY. Bỏ trống thì mặc định là http://localhost:3000, và mọi
# liên kết gửi tới điện thoại người dùng đều là LINK CHẾT — tin vẫn gửi thành
# công, không có lỗi nào, chỉ là không ai bấm được. Đây là kiểu hỏng tệ nhất
# vì nó không hiện ra ở đâu cả.
TERRATWIN_PUBLIC_URL=https://terratwin-web.onrender.com

# Danh sách gốc URL được phép gọi API, phân tách bằng dấu phẩy.
# Để trống hoặc "*" là cho phép tất cả — chỉ nên dùng khi phát triển.
TERRATWIN_CORS=https://terratwin-web.onrender.com

# Mặc định SQLite (chạy ngay, không cần cài gì). Lên production dùng PostgreSQL.
# TERRATWIN_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/terratwin


# ---------------------------------------------------------------------------
# 2. GỬI CẢNH BÁO TỚI NGƯỜI DÙNG
# ---------------------------------------------------------------------------
# Không đặt gì thì chỉ còn kênh webhook. Radar vẫn sinh cảnh báo và vẫn lưu vào
# nhật ký, nhưng KHÔNG có đường nào tới điện thoại một người làm ruộng.

# --- Zalo ZNS (kênh thật của thị trường Việt Nam) ---
# Cần giấy phép kinh doanh + mẫu tin được Zalo duyệt. Đây là thời gian LỊCH
# (1–2 tuần), không phải thời gian làm — nộp hồ sơ sớm.
#   https://business.zalo.me → Zalo Notification Service
TERRATWIN_ZALO_TOKEN=
TERRATWIN_ZALO_TEMPLATE_ID=
# Tên tham số trong mẫu tin bạn đăng ký. Mặc định "content".
TERRATWIN_ZALO_PARAM=content

# --- Telegram (chạy được ngay, không xét duyệt) ---
# Nhắn /newbot cho @BotFather, mất khoảng một phút. Dùng làm kênh tạm trong lúc
# chờ Zalo duyệt, hoặc cho người dùng kỹ thuật.
TERRATWIN_TELEGRAM_TOKEN=

# --- Email (SMTP) ---
TERRATWIN_SMTP_HOST=
TERRATWIN_SMTP_PORT=587
TERRATWIN_SMTP_USER=
TERRATWIN_SMTP_PASSWORD=
TERRATWIN_SMTP_FROM=


# ---------------------------------------------------------------------------
# 3. TRỢ LÝ LLM (tuỳ chọn — không có vẫn trả lời được bằng bộ luật)
# ---------------------------------------------------------------------------
# TerraTwin KHÔNG gắn với nhà cung cấp nào. Cắm khoá của ai cũng chạy.
#
#   · openai-compatible (DeepSeek, Groq, OpenRouter, Together, xAI, Qwen,
#     Mistral, Ollama, LM Studio, vLLM): đặt API_KEY + BASE_URL + MODEL,
#     KHÔNG cần đặt PROVIDER.
#   · Gemini hoặc Anthropic: BẮT BUỘC đặt PROVIDER. Thiếu nó thì chế độ auto
#     coi khoá là openai-compatible, gửi sai giao thức, và trợ lý lặng lẽ tụt
#     về bộ luật mà không báo lỗi gì.
#
# LLM CHỈ ĐƯỢC DIỄN ĐẠT, KHÔNG BAO GIỜ ĐƯỢC SINH RA CON SỐ. Mọi con số đều do
# mô hình vật lý tính. Đây là ranh giới không được phép nới.
TERRATWIN_LLM_PROVIDER=          # auto | openai | gemini | anthropic | off
TERRATWIN_LLM_API_KEY=
TERRATWIN_LLM_BASE_URL=
TERRATWIN_LLM_MODEL=


# ---------------------------------------------------------------------------
# 4. ẢNH VỆ TINH (tuỳ chọn — đã có đường không cần khoá)
# ---------------------------------------------------------------------------
# Microsoft Planetary Computer phục vụ Sentinel-2 KHÔNG CẦN KHOÁ và đã bật sẵn.
# Hai biến dưới chỉ dành cho ai muốn dùng Copernicus Sentinel Hub thay thế.
#   https://dataspace.copernicus.eu → Sentinel Hub → OAuth clients
TERRATWIN_COPERNICUS_ID=
TERRATWIN_COPERNICUS_SECRET=


# ---------------------------------------------------------------------------
# 5. VẬN HÀNH
# ---------------------------------------------------------------------------

# Môi trường tạo cảnh báo: "dev" hay "prod". QUAN TRỌNG cho sổ điểm tự chấm.
#   · Chạy CỤC BỘ / thử nghiệm → đặt "dev": cảnh báo test được đánh dấu env=dev
#     và KHÔNG lẫn vào sổ điểm công khai (sổ điểm chỉ tính prod, ghi rõ "đã loại
#     N cảnh báo giai đoạn phát triển").
#   · Production → "prod" (mặc định). Quên đặt "dev" ở máy dev thì cảnh báo thử
#     đổ vào sổ điểm prod và làm sai tỉ lệ báo bừa — đúng thứ vừa được sửa.
TERRATWIN_ENV=dev

# Số giờ giữa hai lượt rà soát nền. 0 = tắt (dùng cron ngoài gọi
# POST /api/radar/run). Chạy NHIỀU WORKER thì phải đặt 0, nếu không mỗi worker
# quét một lần và đốt hạn mức Open-Meteo.
TERRATWIN_RADAR_INTERVAL_H=6

# Số request/phút cho mỗi IP. 0 = tắt.
TERRATWIN_RATE_LIMIT=120

# Giờ sống của token đăng nhập.
TERRATWIN_TOKEN_HOURS=72

# Đặt 1 khi chạy sau proxy (Render, Fly, nginx) để đọc đúng IP thật từ
# X-Forwarded-For. Đặt sai thì rate limit tính chung cả thế giới vào một IP.
TERRATWIN_TRUST_PROXY=0

# Trần số lượt gọi RA NGOÀI cùng lúc. Đây là thứ đứng giữa phần mềm và việc bị
# Open-Meteo chặn IP — đừng nâng chỉ vì thấy chậm.
TERRATWIN_UPSTREAM_CONCURRENCY=6

# Số luồng xử lý việc nặng trong tiến trình.
TERRATWIN_WORKERS=4

# Hạn mức tháng cho mỗi khoá API. 0 = không giới hạn. Một khoá bị lộ mà không
# có trần sẽ đốt hết hạn mức ngày của Open-Meteo và MỌI người dùng mất dữ liệu
# theo.
TERRATWIN_KEY_MONTHLY_QUOTA=5000
