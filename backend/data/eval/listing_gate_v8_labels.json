 "ai_labels_seen_by_labeler": "Không thể thấy: nhãn AI chỉ công khai mã băm (6d6cd08) cho tới khi tệp nhãn này đã khoá",
 "guideline": "Bản hướng dẫn trong listing_gate_v8_protocol.json (y nguyên lần 7, commit f3aa050, trước khi thu mẫu)",
 "labeler_decisions": [
  "Tin 1 → 0: \"gần đường liên huyện ra biển\": thứ nằm gần lô là con đường, không phải biển; Bàu Trắng là hồ (bàu), không tính",
  "Tin 2 → D: quy ước dùng cho cả 30 tin: hễ tin nêu cự ly hoặc thời gian ra biển là tính D, không đặt ngưỡng km, vì bảng mã ghi \"cách X km\" mà không giới hạn",
  "Tin 6 → 0: \"chưa chuyển thổ\" là câu phủ định; \"đường Kênh Trung Ương\" là tên đường",
  "Tin 9 → E: suối không tính C; \"quy hoạch đất ở ONT\" với hiện trạng CLN là mới quy hoạch, chưa có đất ở, nên không G",
  "Tin 11 → E: \"QH full ONT\" là quy hoạch, chưa phải đã có ONT",
  "Tin 12 → H: \"đường bờ bao Nàng Rền\" là tên đường, không tính C",
  "Tin 13 → B E: \"cao thoáng\" là khẳng định về độ cao, không chỉ là \"thoáng mát\"",
  "Tin 14 → C G: \"kế bên bến đò, qua sông là tới chợ\" nghĩa là lô nằm sát sông; \"Rạch Giá\" là địa danh, không tính",
  "Tin 18 → C G: \"Tho 150\" là \"thổ 150\", tức 150m² thổ cư viết không dấu",
  "Tin 22 → D: \"hỗ trợ chuyển đổi mục đích sử dụng đất\" là chưa có đất ở, nên không G",
  "Tin 27 → G: đất nuôi trồng thủy sản lợ, mặn nên không phải H; ao không tính C",
  "Tin 28 → E G: \"thấp hơn đường chính\" nên không B; suối không tính C"
 ],
